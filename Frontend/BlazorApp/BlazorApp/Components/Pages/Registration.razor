@page "/user"
@inject IHttpClientFactory ClientFactory

<PageTitle>Registration</PageTitle>

<h3>Registration</h3>

<div style="margin: 1em">
	<input placeholder="E-Mail" @bind-value="email"/>
	<input placeholder="login" @bind-value="login"/>
	<input placeholder="Password" @bind-value="password"/>

	<p>@ResponseBody</p>
</div>

<button class="btn btn-primary" @onclick="SignInUser">Sign In</button>

@code {
	string? email, login, password;

	string? ResponseBody;

	HttpClient httpClient = null!;

	class User
	{
		public string? email { get; set; }
		public string? login { get; set; }
		public string? password { get; set; }
	}

	private async Task SignInUser(){
		httpClient = ClientFactory.CreateClient();
		httpClient.BaseAddress = new Uri("https:/localhost:7226/user");

		var request = new HttpRequestMessage()
		{
			Method = new HttpMethod("POST"),
				RequestUri = new Uri("https:/localhost:7226/user"),
			Content = 
				JsonContent.Create(new User
				{
					email = email,
					login = login,
					password = password
				})
		};
		request.Headers.Add("Accept", "text/plain");
		request.Headers.Add("Content-Type", "application/json");

		var response = await httpClient.SendAsync(request);

		ResponseBody = await response.Content.ReadAsStringAsync();
	}
}
